{
  "properties": {
    "displayName": "Require valid department tag on resource groups and virtual machines",
    "policyType": "Custom",
    "mode": "All",
    "description": "Audits or denies resource groups and virtual machines whose department tag is missing or does not exactly match an allowed department value.",
    "metadata": {
      "category": "Tags"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the policy and choose whether violations are audited or denied."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "excludedRGNames": {
        "type": "Array",
        "metadata": {
          "displayName": "Excluded resource group names",
          "description": "Resource group names excluded from evaluation, including virtual machines in those groups."
        },
        "defaultValue": []
      },
      "allowedDepartmentValues": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed department values",
          "description": "Department values accepted by the policy."
        },
        "defaultValue": [
          "Engineering",
          "Operations"
        ]
      },
      "rgNamePatterns": {
        "type": "Array",
        "metadata": {
          "displayName": "Resource group name patterns",
          "description": "Case-sensitive Azure Policy match patterns for resource groups in scope."
        },
        "defaultValue": [
          "R###RG??##"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "in": [
              "Microsoft.Resources/subscriptions/resourceGroups",
              "Microsoft.Compute/virtualMachines"
            ]
          },
          {
            "value": "[if(equals(field('type'), 'Microsoft.Compute/virtualMachines'), resourceGroup().name, field('name'))]",
            "notIn": "[parameters('excludedRGNames')]"
          },
          {
            "count": {
              "value": "[parameters('rgNamePatterns')]",
              "name": "rgNamePattern",
              "where": {
                "value": "[if(equals(field('type'), 'Microsoft.Compute/virtualMachines'), resourceGroup().name, field('name'))]",
                "match": "[current('rgNamePattern')]"
              }
            },
            "greater": 0
          },
          {
            "anyOf": [
              {
                "field": "tags['department']",
                "exists": "false"
              },
              {
                "field": "tags['department']",
                "equals": ""
              },
              {
                "count": {
                  "value": "[parameters('allowedDepartmentValues')]",
                  "name": "allowedDepartment",
                  "where": {
                    "allOf": [
                      {
                        "field": "tags['department']",
                        "match": "[current('allowedDepartment')]"
                      },
                      {
                        "field": "tags['department']",
                        "equals": "[current('allowedDepartment')]"
                      }
                    ]
                  }
                },
                "equals": 0
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
